# RoadGuard AI — Environment Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="RoadGuard AI"

# Model & Evaluation Paths
MODEL_PATH="artifacts/models/best.pt"
METRICS_PATH="artifacts/metrics/evaluation_metrics.json"

# Persistent Storage & Database
# Local SQLite default:
DATABASE_URL="sqlite:///./roadguard.db"
# Railway production with persistent volume mounted at /data:
# DATABASE_URL="sqlite:////data/roadguard.db"

UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"

# Upload Size Limits (MB)
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=100

# Video Sampling (Process every Nth frame for balanced CPU inference)
VIDEO_FRAME_SAMPLE_RATE=5

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of explicitly allowed frontend origins (no wildcard '*' allowed)
# In production on Render / Railway, set to your actual Vercel domain:
# CORS_ORIGINS="https://roadguard-ai.vercel.app,http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Frontend Configuration (Vite)
# Leave empty for local development with Vite dev proxy
# In production on Vercel, set to your live backend domain:
# VITE_API_URL="https://roadguard-ai-production.up.railway.app"
VITE_API_URL=""
